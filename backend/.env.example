# Non-secret runtime config only. Real credentials (GST/GoFrugal/Razorpay/WhatsApp/Uber Direct)
# live in Google Secret Manager, never here and never committed to git.

PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)

# Used to sign the short-lived custom JWTs this backend issues after OTP verification.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Store the real value in Secret Manager as `jwt-signing-key`, not here.
JWT_SIGNING_KEY_SECRET_NAME=jwt-signing-key

# ── Modern Drivers (driver tracking subsystem) ───────────────────────────
# The Firebase uid that the drivers dashboard signs in as. Must match
# isAdmin() in backend/firestore.rules and ADMIN_UID in legal/drivers/config.js.
# Leave unset to use the default already baked into adminAuth.js.
# ADMIN_FIREBASE_UID=

# Browser origins allowed to call this API. The drivers dashboard origin MUST
# be listed or every request from it fails CORS. Comma-separated.
# ALLOWED_ORIGINS=https://modern-dairy-pune.web.app

# GoFrugal order import (optional). The API KEY itself lives in Secret Manager
# as `gofrugal-api-key` — only the non-secret endpoint shape belongs here.
# GOFRUGAL_API_BASE_URL=https://api.gofrugal.com/rayapi/v1
# GOFRUGAL_ORDERS_ENDPOINT=/salesOrders
# GOFRUGAL_TIMEOUT_MS=20000

# Processing thresholds are NOT environment variables. They live in Firestore
# at drivers_config/singleton, are editable from the dashboard, are audit-logged
# and are stamped onto every processing result — so an old report can always be
# explained by the thresholds that produced it. See backend/src/drivers/config.js.
