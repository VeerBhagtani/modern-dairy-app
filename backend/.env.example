# Non-secret runtime config only. The JWT signing key lives in Google Secret
# Manager as `jwt-signing-key` — never here, never in git.

PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)

# Browser origins allowed to call this API. The dashboard's origin MUST be
# listed or every request from it fails CORS. Comma-separated.
# The deploy workflow sets this automatically.
ALLOWED_ORIGINS=https://your-project.web.app

# Set in production so the HTTPS redirect is active.
NODE_ENV=production

# Optional: GoFrugal order import. The API key itself goes in Secret Manager
# as `gofrugal-api-key`; only the non-secret endpoint shape belongs here.
# GOFRUGAL_API_BASE_URL=https://api.gofrugal.com/rayapi/v1
# GOFRUGAL_ORDERS_ENDPOINT=/salesOrders

# Processing thresholds are NOT environment variables. They live in Firestore
# at drivers_config/singleton, are editable from the dashboard, are audit
# logged, and are stamped onto every result — so an old report can always be
# explained by the thresholds that produced it. See src/drivers/config.js.
