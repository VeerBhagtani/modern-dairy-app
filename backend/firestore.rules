rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Interim architecture until the backend is deployed to Cloud Run
    // (blocked on the Blaze plan / a payment method until 2026-09-11):
    // the customer app writes orders directly here (anonymous auth, so
    // there's at least a real Firebase session behind every write), and
    // the admin website — a separate Firebase-Auth-gated static site —
    // reads/manages everything. Once the backend deploys, real writes
    // move behind the Admin SDK (which bypasses these rules via a service
    // account) and this goes back to a deny-all backstop.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '63cH4Dduh4WS7okdV0s0DcJtD7q2';
    }
    function isOwner() {
      return request.auth != null && resource.data.createdByUid == request.auth.uid;
    }
    // Riders are deliberately NOT a Firestore identity. They sign in with
    // nothing — see /deliveries below, which is the only thing they touch.
    // Statuses a customer is still allowed to cancel from — once an order
    // is out for delivery (or later), only the admin can see it change and
    // the customer must call in instead. This must match CANCELLABLE_STATUSES
    // in www/index.html — keep both in sync if either changes.
    function isCancellable(status) {
      return status in ['placed', 'confirmed', 'pending_confirmation', 'packed'];
    }

    // Every item must look like a real cart line (positive price/qty,
    // sane bounds) — doesn't prove the price matches the real catalogue
    // (Firestore rules can't cheaply re-look-up up to 50 products per
    // write), so that's checked out-of-band by
    // backend/scripts/verify-order-prices.js, which flags any order whose
    // prices don't match products/{id} for admin review. This is
    // defense-in-depth against obviously-garbage writes, not a substitute.
    function isValidOrderItem(item) {
      return item.keys().hasAll(['pk', 'vid', 'qty', 'price'])
             && item.price is number && item.price > 0 && item.price <= 100000
             && item.qty is number && item.qty > 0 && item.qty <= 1000
             && item.pk is string && item.pk.size() > 0 && item.pk.size() <= 128
             && item.vid is string && item.vid.size() > 0 && item.vid.size() <= 64;
    }
    // Rules can't iterate a list, so sample the ends plus the second entry —
    // enough that a forged write can't hide junk behind one well-formed item.
    function itemsSampled(items) {
      return isValidOrderItem(items[0])
             && isValidOrderItem(items[items.size() - 1])
             && (items.size() < 2 || isValidOrderItem(items[1]));
    }
    // The money must add up. This is the check that actually closes the
    // "real item prices, total: 1" forgery: previously `total` was bounded
    // (0 < total <= 500000) but never tied to anything, so a direct
    // Firestore write could keep genuine line items and simply declare a
    // ₹1 total. Rules can't sum a variable-length item list, but they CAN
    // require the declared parts to be internally consistent, which leaves
    // only the per-item price to be checked out-of-band by
    // backend/scripts/verify-order-prices.js. 1-rupee slack absorbs the
    // client's GST rounding.
    // `platform` (flat platform fee, e.g. ₹2) is OPTIONAL via get(...,0) so
    // orders from older app builds that don't send it still validate; when
    // present it must be a small non-negative number and is included in the sum.
    function totalsAddUp(d) {
      return d.subtotal is number && d.subtotal > 0 && d.subtotal <= 500000
             && d.gst is number && d.gst >= 0 && d.gst <= 500000
             && d.delivery is number && d.delivery >= 0 && d.delivery <= 100000
             && d.get('platform', 0) is number && d.get('platform', 0) >= 0 && d.get('platform', 0) <= 1000
             && math.abs(d.total - (d.subtotal + d.gst + d.delivery + d.get('platform', 0))) <= 1;
    }
    // Optional free-text field: absent/null, or a string within a length cap
    // (stops a forged write from stuffing megabytes of junk into an order).
    function strOk(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    // Credit hold / block list. The admin can stop a specific customer (by
    // phone) from placing orders — e.g. over their credit limit. This is
    // enforced HERE, at the rules layer, so it is authoritative: a blocked
    // customer's order write is denied on the server, not just hidden in the
    // app. The block list (order_blocks/list.blockedPhones) is an admin-only
    // doc, but rules get()/exists() can still read it. Absent list => nobody
    // blocked (fail-open on the list's existence, never on a real block).
    function notBlocked(d) {
      return !exists(/databases/$(database)/documents/order_blocks/list)
             || !(d.phone in get(/databases/$(database)/documents/order_blocks/list).data.get('blockedPhones', []));
    }
    match /orders/{orderId} {
      // Any authenticated (including anonymous) client can create an order,
      // tagged with their own uid as the owner. The field set is LOCKED with
      // hasOnly (not just hasAll) so a direct/forged Firestore write can't
      // smuggle in extra fields — critically, it can't pre-set priceVerified
      // (which would make verify-order-prices.js skip the order) or force a
      // later status. status is pinned to 'placed' so every order enters the
      // real lifecycle; the out-of-band cron then price-checks it.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['orderNo', 'items', 'subtotal', 'gst', 'delivery', 'total', 'status', 'placedAt', 'createdByUid'])
                    && request.resource.data.keys().hasOnly(['orderNo', 'items', 'subtotal', 'gst', 'delivery', 'platform', 'total', 'payment', 'customerType', 'company', 'gstin', 'name', 'phone', 'address', 'status', 'createdByUid', 'placedAt'])
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.status == 'placed'
                    && request.resource.data.customerType in ['b2b', 'b2c']
                    && request.resource.data.total is number
                    && request.resource.data.total > 0 && request.resource.data.total <= 500000
                    && totalsAddUp(request.resource.data)
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
                    && itemsSampled(request.resource.data.items)
                    // placedAt: serverTimestamp() on the SDK path, an ISO
                    // string on the plain-REST fallback path. Both are fine;
                    // anything else (a number, a map) is not.
                    && (request.resource.data.placedAt is timestamp
                        || (request.resource.data.placedAt is string && request.resource.data.placedAt.size() <= 40))
                    && request.resource.data.orderNo is string
                    && request.resource.data.orderNo.size() > 0 && request.resource.data.orderNo.size() <= 60
                    && strOk(request.resource.data.name, 120)
                    && strOk(request.resource.data.phone, 20)
                    && strOk(request.resource.data.company, 200)
                    && strOk(request.resource.data.gstin, 20)
                    && strOk(request.resource.data.address, 500)
                    && strOk(request.resource.data.payment, 40)
                    && notBlocked(request.resource.data);

      // Owner can read their own order (powers live status sync back to the
      // phone) and can self-cancel it — but ONLY while still cancellable,
      // ONLY by setting status to 'cancelled', and ONLY that field (plus a
      // cancelledAt timestamp) may change. No human — including the admin —
      // can set an order to cancelled; that status is customer-triggered only.
      allow read: if isAdmin() || isOwner();
      allow update: if isAdmin()
                    || (isOwner()
                        && isCancellable(resource.data.status)
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isAdmin();
    }
    // The three blocks below used to sit INSIDE /orders/{orderId}, which made
    // them rules for orders/{id}/deliveries/... sub-collections. The real
    // top-level collections then fell through to the admin-only catch-all, so
    // riders and customers were refused every delivery read (tracking never
    // worked) and the app could never read the public hold list.

    // Admin-only credit-hold / block list (read via get() by the order rule
    // above; never exposed to customers). Public hash list lives separately.
    match /order_blocks/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Deliveries: the rider's entire world ────────────────────────────
    // A rider signs in with nothing. They open the link (or type the code)
    // the office sent them, and that code IS the key: the document id is a
    // random 10-character delivery code, never the guessable order number.
    // The customer reaches the same record through the code the office
    // writes onto their own order.
    //
    // This exists so a rider never touches an order document. An order holds
    // the customer's full record — name, phone, address, GSTIN, items, totals.
    // A delivery holds only what someone standing on a doorstep needs, copied
    // across by the admin when the order goes out for delivery.
    //
    // get vs list is the load-bearing distinction. A get fetches ONE document
    // by id, so it requires already knowing the order number. A list would let
    // anyone enumerate every delivery, so it stays admin-only. Without that
    // split, "no rider login" would mean "every customer's address is public",
    // which is not a trade worth making.
    //
    // Residual risk, stated plainly: anyone who knows a live order number can
    // see that one delivery's address and post a location to it. The admin
    // sees the rider's name and phone on every update, and the document stops
    // accepting writes the moment the order leaves out_for_delivery.
    function isDeliveryLocationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['riderLat', 'riderLng', 'riderAt', 'riderAccuracy', 'riderName', 'riderPhone'])
             && request.resource.data.riderLat is number
             && request.resource.data.riderLat >= -90 && request.resource.data.riderLat <= 90
             && request.resource.data.riderLng is number
             && request.resource.data.riderLng >= -180 && request.resource.data.riderLng <= 180
             && request.resource.data.riderName is string
             && request.resource.data.riderName.size() > 0
             && request.resource.data.riderName.size() <= 80
             && strOk(request.resource.data.riderPhone, 20)
             // Tracking cannot outlive the delivery: the admin sets active
             // false when the status moves on, and writes stop being accepted.
             && resource.data.active == true;
    }
    match /deliveries/{orderNo} {
      allow get: if request.auth != null;      // must know the order number
      allow list: if isAdmin();                // never enumerable
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isDeliveryLocationUpdate();
    }
    match /order_blocks_public/{docId} {
      allow read: if true;          // opaque phone hashes only — for app UX
      allow write: if isAdmin();
    }

    // Catalogue/config: public read (so the app could fetch these directly
    // in future), admin-only write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Admin broadcast announcements (e.g. "fresh paneer back in stock") —
    // public read so any customer can see them, admin-only write/delete.
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // FCM device tokens, keyed by the token itself so re-registering the
    // same device overwrites in place instead of piling up duplicates. Any
    // signed-in (including anonymous) client can register/update its own
    // token; only the admin (and the server-side broadcast relay, which
    // uses a service account and bypasses rules entirely) can read them.
    match /device_tokens/{tokenId} {
      allow read: if isAdmin();
      // Register/refresh your OWN token only: the doc id must equal the token
      // itself, the uid must be the caller's, and you can only overwrite a doc
      // you already own (resource == null on first write) — so one client
      // can't hijack, re-point, or re-audience another device's token doc.
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['token', 'audience', 'uid', 'updatedAt'])
                   && request.resource.data.token is string
                   && request.resource.data.token.size() <= 4096
                   && request.resource.data.token == tokenId
                   && request.resource.data.audience in ['b2b', 'b2c']
                   && request.resource.data.uid == request.auth.uid
                   && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ── Driver requests ("Request a driver", business customers) ─────────
    // A hotel asks the office for a driver: to collect a payment (cash or
    // cheque), for an urgent delivery, or for other help. Customers can only
    // create one — pinned field set, pinned to 'open' — and withdraw it while
    // it is still open. The office moves it on from the admin website.
    match /driver_requests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['reason', 'phone', 'customerType', 'status', 'createdByUid', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['reason', 'note', 'company', 'name', 'phone', 'address', 'gstin', 'customerType', 'status', 'createdByUid', 'createdAt'])
                    && request.resource.data.createdByUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.customerType == 'b2b'
                    && request.resource.data.reason in ['collect_payment', 'urgent_delivery', 'other']
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.phone is string
                    && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
                    && strOk(request.resource.data.get('note', null), 300)
                    && strOk(request.resource.data.get('company', null), 200)
                    && strOk(request.resource.data.get('name', null), 120)
                    && strOk(request.resource.data.get('address', null), 500)
                    && strOk(request.resource.data.get('gstin', null), 20);
      allow read: if isAdmin() || isOwner();
      allow update: if isAdmin()
                    || (isOwner()
                        && resource.data.status == 'open'
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    // ── Customer accounts (the admin Account Center) ─────────────────────
    // Accounts still live on each phone; the app copies the profile here so
    // the office can see and manage every customer. Passwords never come
    // here. The id must be "<this install's uid>_<phone>", so a client can
    // only ever write its own records. The `admin` map holds the office's
    // edits: customers can't create or change it, and the app applies it
    // back to the phone.
    function accountFieldsOk(d) {
      return d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
             && d.type in ['b2b', 'b2c']
             && strOk(d.get('name', null), 120)
             && strOk(d.get('company', null), 200)
             && strOk(d.get('gstin', null), 20)
             && strOk(d.get('address', null), 500)
             && strOk(d.get('acctLast4', null), 4)
             && (d.get('lat', null) == null || d.get('lat', null) is number)
             && (d.get('lng', null) == null || d.get('lng', null) is number)
             && d.get('bankVerified', false) is bool;
    }
    match /customer_accounts/{accountId} {
      allow create: if request.auth != null
                    && accountId == request.auth.uid + '_' + request.resource.data.phone
                    && request.resource.data.keys().hasOnly(['phone', 'type', 'name', 'company', 'gstin', 'address', 'lat', 'lng', 'bankVerified', 'acctLast4', 'createdAt', 'updatedAt'])
                    && accountFieldsOk(request.resource.data);
      allow update: if isAdmin()
                    || (request.auth != null
                        && accountId == request.auth.uid + '_' + resource.data.phone
                        && request.resource.data.phone == resource.data.phone
                        && request.resource.data.keys().hasOnly(['phone', 'type', 'name', 'company', 'gstin', 'address', 'lat', 'lng', 'bankVerified', 'acctLast4', 'createdAt', 'updatedAt', 'admin'])
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'createdAt'])
                        && accountFieldsOk(request.resource.data));
      // A get of a missing doc must succeed (the app checks before its first
      // write), so this matches the id pattern rather than reading resource.
      allow get: if isAdmin() || (request.auth != null && accountId.matches(request.auth.uid + '_[0-9]{10}'));
      allow list, delete: if isAdmin();
    }

    // Everything else (customers, wallet ledgers, admin audit log, OTP
    // challenges) holds personal/financial data — admin-only, no exceptions.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
