node_modules/
.firebase/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
*.apk
*.aab
# ...except one deliberately published demo build, so there is a download link
# that needs no Play Console and no CI artifact login. This is the ONLY binary
# that belongs in git: it carries no credentials (DEMO build, see
# scripts/preflight.js --built) and is debug-signed, so it can never be
# mistaken for a release. Real releases go through the Play Console.
!dist/*.apk
.idea/

# iOS — the native project is generated on demand (`npx cap add ios`), same
# as CI does; never commit it or anything signing-related.
ios/
*.ipa
*.mobileprovision
*.p12
*.cer
*.certSigningRequest
*.p8
exportOptions.plist
DerivedData/
*.xcarchive

# Secrets — real credentials belong in Secret Manager / Cloud Run env config,
# never in a committed file. These patterns exist as a backstop in case a
# local .env is ever created for backend dev.
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
serviceAccountKey*.json
firebase-adminsdk*.json

# Local-only secret overrides for www/ (never committed; CI injects the
# real values into www/secrets.js at build time from GitHub Secrets).
www/secrets.local.js

# Firestore emulator artefacts (npm run test:rules)
firestore-debug.log
ui-debug.log
firebase-debug.log
.firebase/
