node_modules/
# The native Android project is generated by `npx cap add android`; committing
# it would mean 200+ files of generated Gradle config to re-sync on every
# Capacitor bump. scripts/patch-manifest.js applies the one thing cap add does
# not know about.
app/android/
# Copied from node_modules/@capacitor/core at build time (see release.yml), so
# its version always matches the native runtime.
app/www/capacitor.js
app/ios/
*.log
.env
.DS_Store
key.json
*-key.json
service-account*.json
.firebase/
