node_modules/
# The native Android project is generated by `npx cap add android`; committing
# it would mean 200+ files of generated Gradle config to re-sync on every
# Capacitor bump. scripts/patch-manifest.js applies the one thing cap add does
# not know about.
app/android/
app/ios/
*.log
.env
.DS_Store
key.json
*-key.json
service-account*.json
.firebase/
